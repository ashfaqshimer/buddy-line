    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "devDependencies": {
    "@buddy-line/eslint-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.7"
  }
}
