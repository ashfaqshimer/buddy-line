# ==============================================================================
# Buddy Line - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.example .env.local
# ==============================================================================

# --- DATABASE CONFIGURATION (NEON POSTGRESQL) ---
# Neon pooled connection string (used for application and runtime queries)
# Format: postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon unpooled direct connection string (used for schema migrations and DDL)
# Format: postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Active Neon branch
NEON_BRANCH="production"

# --- AUTHENTICATION CONFIGURATION (BETTER AUTH) ---
# Base URL for this Next.js app (where auth handlers live)
# In development: http://localhost:3000 | In production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# Secret key used for signing session cookies and encrypting tokens
# Generate one using: openssl rand -base64 32 or npx @better-auth/cli secret
BETTER_AUTH_SECRET="your-super-secret-key-change-this-in-production"

# --- SYSTEM ADMIN & ROOT USERS ---
# Comma-separated list of emails automatically assigned 'admin' privileges upon sign up
# or granted bypass permissions for administrative actions (e.g. deleting any game)
ADMIN_EMAILS="admin@buddyline.com"

# Root/Super Admin emails
ROOT_ADMIN_EMAILS="root@buddyline.com"
